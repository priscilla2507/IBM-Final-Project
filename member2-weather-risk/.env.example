# .env.example — Member 2: Weather & Risk Assessment
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# ── Weather API ───────────────────────────────────────────────────────────── #

# Open-Meteo does not require an API key. Leave WEATHER_API_KEY blank.
# If you switch to a different provider in future, set the key here.
WEATHER_API_KEY=your_api_key_here

# Base URL of the Open-Meteo forecast endpoint (no trailing slash)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# ── Database (Member 4 integration — do not configure until schema agreed) ── #

# Database URL — read by app/db/persistence.py when real persistence is added.
# Do NOT set this until the shared schema has been agreed with Member 4.
# Format: mysql+aiomysql://user:password@host:port/dbname
DATABASE_URL=

# ── App (dev server) ─────────────────────────────────────────────────────── #

# Port used when running the isolated dev server (keep different from 8000
# to avoid conflicts with ai-intelligence-backend running on the same machine)
DEV_PORT=8001
