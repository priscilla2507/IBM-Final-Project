# Environment Configuration for ChhayaRakshak AI Frontend

# ─── Data Mode ────────────────────────────────────────────────────────────────
# Set to "true" to use local sample data (demo mode).
# Set to "false" to attempt live API calls to the backend.
# Default: true (safe for development without a backend)
VITE_USE_DEMO_DATA=true

# ─── Backend API URL ──────────────────────────────────────────────────────────
# Base URL for the FastAPI backend.
# Update this when your teammates' backend is deployed.
VITE_API_URL=http://localhost:8000
